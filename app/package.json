{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc -b && vite build",
    "build:ci": "tsc -b && vite build --mode ci",
    "graphql-codegen": "graphql-codegen -c codegen.ts --ignore-no-documents",
    "lint": "eslint .",
    "preview": "vite preview",
    "switch-env:prod": "./switch-env.sh prod",
    "switch-env:dev": "chmod +x switch-env.sh && ./switch-env.sh dev",
    "switch-env:clean": "./switch-env.sh clean",
    "switch-env:stop": "./switch-env.sh stop",
    "knip": "knip"
  },
  "dependencies": {
    "@shopify/react-i18n": "^7.14.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-i18next": "^17.0.9",
    "tailwindcss": "^4.3.2",
    "use-debounce": "^10.1.1",
    "yup": "^1.7.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shopify/api-codegen-preset": "^3.0.0",
